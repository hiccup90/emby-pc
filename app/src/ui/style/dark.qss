/* =========================================================================
   Emby PC — 深色主题（UI 骨架）
   配色参考 qEmby dark-style.qss 的 Slate 色板思路，但只取颜色 token，
   不复制原文件。主色蓝 #3B82F6；qEmby Slate 色板：背景 #0F172A / 面板卡片 #1E293B / 边框 #334155。
   ========================================================================= */

/* 不使用全局 outline:none；焦点环见文件末尾 T43 规则。 */

QMainWindow,
QWidget#AppRoot,
QWidget#MainColumn,
QWidget#ContentStack {
    background-color: #0F172A;
}

QWidget {
    color: #CBD5E1;
}

QToolTip {
    background-color: #1E293B;
    color: #CBD5E1;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ------------------------------ 侧边栏 ------------------------------ */

QWidget#Sidebar {
    background-color: #1E293B;
    border-right: 1px solid #334155;
}

QLabel#BrandTitle {
    font-size: 17px;
    font-weight: 700;
    color: #F8FAFC;
}

QLabel#BrandSub {
    font-size: 10px;
    color: #94A3B8;
}

QLabel#SidebarSection {
    font-size: 11px;
    color: #94A3B8;
    padding-left: 12px;
}

QPushButton[navButton="true"] {
    text-align: left;
    padding: 0 14px;
    border: none;
    border-radius: 8px;
    background-color: transparent;
    color: #94A3B8;
    font-size: 13px;
    font-weight: 500;
}

QPushButton[navButton="true"]:hover {
    background-color: #334155;
    color: #CBD5E1;
}

QPushButton[navButton="true"]:checked {
    background-color: #1D4ED8;
    color: #FFFFFF;
}

QWidget#ServerCard {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 10px;
}

QLabel#ServerName {
    font-size: 12px;
    font-weight: 600;
    color: #CBD5E1;
}

QLabel#ServerStatus {
    font-size: 10px;
    color: #94A3B8;
}

QLabel#StatusDot {
    background-color: #34D399;
    border-radius: 3px;
}

QLabel#AvatarLabel {
    background-color: #2563EB;
    border-radius: 17px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
}

QLabel#SidebarVersion {
    font-size: 10px;
    color: #475569;
}

/* ------------------------------ 顶栏 / 搜索 ------------------------------ */

QWidget#TopBar {
    background-color: #0F172A;
    border-bottom: 1px solid #334155;
}

QLineEdit#SearchBox {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0 12px;
    color: #CBD5E1;
    font-size: 13px;
    selection-background-color: #2563EB;
}

QLineEdit#SearchBox:focus {
    background-color: #0F172A;
    border: 1px solid #3B82F6;
}

QLabel#TopStatus {
    color: #94A3B8;
    font-size: 12px;
}

QPushButton#TopAvatar {
    background-color: #1E3A8A;
    border: 1px solid #2563EB;
    border-radius: 17px;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#TopAvatar:hover {
    background-color: #1D4ED8;
}

/* ------------------------------ 媒体库 ------------------------------ */

QLabel#LibraryTitle {
    font-size: 22px;
    font-weight: 700;
    color: #F8FAFC;
}

QLabel#LibraryCount {
    font-size: 12px;
    color: #94A3B8;
    padding-bottom: 3px;
}

QComboBox {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 6px 12px;
    min-width: 96px;
    color: #CBD5E1;
    font-size: 12px;
}

QComboBox:hover {
    border-color: #3B82F6;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #1D4ED8;
    selection-color: #FFFFFF;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 5px 10px;
    border-radius: 4px;
}

QListView#PosterGrid {
    background-color: transparent;
    border: none;
}

QLabel#EmptyState {
    color: #94A3B8;
    font-size: 14px;
}

QLabel#EmptyState[state="loading"] {
    color: #93C5FD;
}

QLabel#EmptyState[state="error"] {
    color: #FCA5A5;
}

/* 首页：继续观看横向列表 */

QWidget#ResumeSection {
    background-color: transparent;
}

QScrollArea#ResumeScroll {
    background: transparent;
    border: none;
}

QWidget#ResumeContent {
    background: transparent;
}

QWidget#ResumeCard {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 10px;
}

QWidget#ResumeCard:hover {
    background-color: #334155;
    border-color: #3B82F6;
}

QLabel#ResumeThumbnail {
    background-color: #0F172A;
    border-radius: 6px;
    color: #475569;
    font-size: 10px;
}

QLabel#ResumeCardTitle {
    color: #CBD5E1;
    font-size: 12px;
}

QLabel#ResumeCardMeta {
    color: #94A3B8;
    font-size: 10px;
}

QProgressBar#ResumeProgress {
    background-color: #1E293B;
    border: none;
    border-radius: 2px;
}

QProgressBar#ResumeProgress::chunk {
    background-color: #3B82F6;
    border-radius: 2px;
}

QLabel#SettingHint {
    color: #94A3B8;
    font-size: 11px;
    padding-right: 6px;
}

/* 首页 banner */

QWidget#HeroBanner {
    background-color: #1E293B;
    border-radius: 12px;
}

QLabel#HeroBadge {
    background-color: rgba(59, 130, 246, 0.90);
    color: #FFFFFF;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#HeroTitle {
    font-size: 28px;
    font-weight: 700;
    color: #F8FAFC;
}

QLabel#HeroMeta {
    font-size: 12px;
    color: #94A3B8;
}

QLabel#HeroOverview {
    font-size: 12px;
    color: #CBD5E1;
}

/* ------------------------------ 通用按钮 ------------------------------ */

QPushButton[role="primary"] {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 7px;
    padding: 9px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton[role="primary"]:hover {
    background-color: #1D4ED8;
}

QPushButton[role="primary"]:pressed {
    background-color: #1E40AF;
}

QPushButton[role="primary"]:disabled {
    background-color: #1E293B;
    color: #94A3B8;
}

QPushButton[role="secondary"] {
    background-color: #334155;
    color: #CBD5E1;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 9px 18px;
    font-size: 13px;
}

QPushButton[role="secondary"]:hover {
    background-color: #475569;
    border-color: #3B82F6;
}

QPushButton[role="secondary"]:pressed {
    background-color: #1E293B;
}

QPushButton[role="ghost"] {
    background-color: transparent;
    color: #94A3B8;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

QPushButton[role="ghost"]:hover {
    background-color: #334155;
    color: #CBD5E1;
}

/* ------------------------------ 详情页 ------------------------------ */

QWidget#DetailTopBar {
    background-color: #0F172A;
    border-bottom: 1px solid #334155;
}

QLabel#DetailBreadcrumb {
    color: #94A3B8;
    font-size: 12px;
}

QScrollArea#DetailScroll,
QScrollArea#SettingsScroll {
    background-color: transparent;
    border: none;
}

QWidget#DetailContent,
QWidget#DetailBody {
    background-color: #0F172A;
}

QLabel#DetailTypeBadge {
    background-color: rgba(59, 130, 246, 0.16);
    color: #93C5FD;
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
}

QLabel#DetailTitle {
    font-size: 30px;
    font-weight: 700;
    color: #F8FAFC;
}

QLabel#DetailMeta {
    font-size: 12px;
    color: #94A3B8;
}

QLabel#DetailTagline {
    font-size: 12px;
    color: #94A3B8;
}

QLabel#DetailPoster {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 10px;
    color: #475569;
    font-size: 12px;
}

QLabel#SectionTitle {
    font-size: 16px;
    font-weight: 700;
    color: #F8FAFC;
}

QLabel#DetailOverview {
    font-size: 13px;
    color: #CBD5E1;
}

QLabel#DetailChip {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 11px;
    color: #94A3B8;
}

QWidget#EpisodeRow {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
}

QWidget#EpisodeRow:hover {
    background-color: #334155;
    border-color: #475569;
}

QLabel#EpisodeTitle {
    font-size: 13px;
    font-weight: 600;
    color: #CBD5E1;
}

QLabel#EpisodeMeta {
    font-size: 11px;
    color: #94A3B8;
}

QLabel#EpisodeThumbnail {
    background-color: #1E293B;
    border-radius: 6px;
}

QProgressBar#EpisodeProgress {
    background-color: #334155;
    border: none;
    border-radius: 2px;
}

QProgressBar#EpisodeProgress::chunk {
    background-color: #3B82F6;
    border-radius: 2px;
}

QLabel#EpisodePlayedBadge {
    background-color: rgba(52, 211, 153, 0.12);
    color: #34D399;
    border: 1px solid rgba(52, 211, 153, 0.30);
    border-radius: 9px;
    padding: 3px 9px;
    font-size: 10px;
}

QLabel#EpisodeCount {
    font-size: 12px;
    color: #94A3B8;
}

/* ------------------------------ 播放页 ------------------------------ */

QWidget#PlayerPage {
    background-color: #000000;
}

/* 播放器模式：视频铺满整页，顶部/底部控制条是压在视频上的半透明渐变浮层。 */
QWidget#PlayerTopBar {
    /* T55：不透明顶层窗口；不要用 rgba/渐变透明，Windows 会按 alpha 穿透命中。 */
    background-color: #0B1220;
    border: none;
    border-bottom: 1px solid #1E293B;
}

QLabel#PlayerTitle {
    font-size: 16px;
    font-weight: 600;
    color: #F8FAFC;
}

QLabel#PlayerSubtitle {
    font-size: 12px;
    color: #94A3B8;
}

QLabel#PlayerModeBadge {
    background-color: rgba(148, 163, 184, 0.12);
    color: #94A3B8;
    border: 1px solid #334155;
    border-radius: 9px;
    padding: 3px 9px;
    font-size: 10px;
}

QStackedWidget#VideoArea {
    background-color: #000000;
}

QLabel#VideoHostTitle {
    font-size: 16px;
    font-weight: 600;
    color: #94A3B8;
}

QLabel#VideoHostDesc {
    font-size: 12px;
    color: #475569;
}

QLabel#VideoHostHint {
    font-size: 11px;
    color: #334155;
}

QWidget#PlayerControlBar {
    background-color: #0B1220;
    border: none;
    border-top: 1px solid #1E293B;
}

QLabel#PlayerTimeLabel {
    color: #94A3B8;
    font-size: 12px;
}

QPushButton[role="playerIcon"] {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QPushButton[role="playerIcon"]:hover {
    background-color: #334155;
}

QPushButton[role="playerIcon"]:pressed {
    background-color: #334155;
}

QPushButton[role="playerPrimary"] {
    background-color: #3B82F6;
    border: none;
    border-radius: 24px;
}

QPushButton[role="playerPrimary"]:hover {
    background-color: #2563EB;
}

QPushButton[role="playerPrimary"]:pressed {
    background-color: #1E40AF;
}

QPushButton[role="playerText"] {
    background-color: transparent;
    color: #CBD5E1;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0;
    font-size: 13px;
}

QPushButton[role="playerText"]:hover {
    background-color: #334155;
    border-color: #334155;
}

/* ------------------------------ 滑杆 ------------------------------ */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #334155;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #3B82F6;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background-color: #334155;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
    background-color: #60A5FA;
}

QSlider::handle:horizontal:hover {
    background-color: #93C5FD;
}

QSlider#SeekSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background-color: #F8FAFC;
    border: 2px solid #3B82F6;
}

QSlider#VolumeSlider::groove:horizontal {
    height: 3px;
}

QSlider#VolumeSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

/* ------------------------------ 设置页 ------------------------------ */

QWidget#SettingsPage {
    background-color: #0F172A;
}

QLabel#PageTitle {
    font-size: 24px;
    font-weight: 700;
    color: #F8FAFC;
}

QLabel#PageSubtitle {
    font-size: 12px;
    color: #94A3B8;
}

QGroupBox#SettingsGroup {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 12px;
    color: #CBD5E1;
}

QGroupBox#SettingsGroup::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 6px;
    color: #94A3B8;
    font-size: 12px;
    font-weight: 600;
}

QLabel#SettingName {
    color: #CBD5E1;
    font-size: 13px;
}

QLabel#SettingValue,
QLabel#SettingsConnectionValue,
QLabel#SettingsCacheUsageValue,
QLabel#SettingsHardwareDecoderValue,
QLabel#SettingsAppVersionValue,
QLabel#SettingsQtVersionValue,
QLabel#SettingsBuildTimeValue,
QLabel#SettingsLibmpvVersionValue {
    color: #94A3B8;
    font-size: 12px;
}

QLabel#SettingsConnectionValue[state="connected"] {
    color: #6EE7B7;
}

QLabel#SettingsConnectionValue[state="disconnected"] {
    color: #FCA5A5;
}

QSpinBox {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 5px 10px;
    min-width: 96px;
    color: #CBD5E1;
    font-size: 12px;
}

QSpinBox:hover {
    border-color: #3B82F6;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 18px;
    border: none;
    background-color: transparent;
}

/* T38 侧边栏分隔器 / 首页多分栏 / 媒体库设置 */

/* T58：splitter 自身没有背景规则时会退回 palette（QPalette::Base/#111C2E），
   与 AppRoot/MainColumn 的 #0F172A 差一档，退出播放后新暴露的区域会出现
   一条“边框感”色带。 */
QSplitter#MainSplitter {
    background-color: #0F172A;
}

QSplitter#MainSplitter::handle {
    background-color: #1E293B;
    width: 4px;
}

QSplitter#MainSplitter::handle:hover {
    background-color: #3B82F6;
}

/* T58 首页各层容器背景：与 AppRoot/MainColumn/ContentStack 统一 #0F172A。
   HomeViewStack 是 QFrame 子类（QStackedWidget），QSS background 由 PE_Frame
   绘制；HomeLegacyPage 是纯 QWidget（Qt 会为该类控件自动置 WA_StyledBackground）。 */
QWidget#HomePage,
QWidget#HomeLegacyPage,
QWidget#HomeViewStack {
    background-color: #0F172A;
}

QScrollArea#HomeSectionsScroll {
    background-color: #0F172A;
    border: none;
}

/* QAbstractScrollArea 的 viewport 是内部子控件，默认 autoFillBackground 用
   QPalette::Base(#111C2E)，比 #0F172A 亮一档。首页 sectioned 内容铺满 viewport
   （widgetResizable + Ignored/Preferred），给它同色即可覆盖掉那圈色差。
   两种写法都保留：objectName 直写 + 三级后代选择器，任一命中即可。 */
QWidget#HomeSectionsContent,
QScrollArea#HomeSectionsScroll > QWidget > QWidget {
    background-color: #0F172A;
}

QLabel#HomeSectionTitle {
    color: #CBD5E1;
    font-size: 18px;
    font-weight: 700;
    padding: 2px 0 4px 0;
}

QLabel#HomeSectionCardTitle {
    color: #CBD5E1;
    font-size: 13px;
    font-weight: 600;
}

QLabel#HomeSectionCardMeta {
    color: #94A3B8;
    font-size: 11px;
}

QLabel#SettingsLibraryHint {
    color: #94A3B8;
    font-size: 12px;
    padding: 2px 0 6px 0;
}

QWidget#SettingsLibraryRow {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 6px 10px;
}

QSplitter#MainSplitter::handle:horizontal {
    width: 4px;
}

/* ------------------------------ 菜单 / 状态栏 / 滚动条 ------------------------------ */

QMenu {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 26px 7px 12px;
    border-radius: 5px;
    color: #CBD5E1;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #1D4ED8;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #475569;
}

QStatusBar {
    background-color: #0F172A;
    color: #94A3B8;
    border-top: 1px solid #334155;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

/* T43 qEmby scrollbar：10px，半透明 Slate-400 handle，hover/pressed 加宽 */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgba(148, 163, 184, 0.30);
    min-height: 30px;
    margin: 0px 3px;
    border-radius: 2px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed {
    background: rgba(148, 163, 184, 0.65);
    margin: 0px 1px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    border: none;
    background: none;
    height: 0px;
}
QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: rgba(148, 163, 184, 0.30);
    min-width: 30px;
    margin: 3px 0px;
    border-radius: 2px;
}
QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed {
    background: rgba(148, 163, 184, 0.65);
    margin: 1px 0px;
    border-radius: 4px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    border: none;
    background: none;
    width: 0px;
}

/* ------------------------------ 登录 / 账户 ------------------------------ */

QDialog#LoginDialog {
    background-color: #0F172A;
}

QLabel#LoginTitle {
    font-size: 24px;
    font-weight: 700;
    color: #F8FAFC;
}

QLabel#LoginSubtitle {
    font-size: 13px;
    color: #94A3B8;
}

QLineEdit[role="formInput"] {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 20px;
    color: #CBD5E1;
    selection-background-color: #2563EB;
}

QLineEdit[role="formInput"]:focus {
    border-color: #3B82F6;
    background-color: #0F172A;
}

QLineEdit[role="formInput"]:disabled {
    color: #94A3B8;
    background-color: #0F172A;
}

QCheckBox {
    color: #94A3B8;
    font-size: 12px;
    spacing: 8px;
}

QCheckBox:hover {
    color: #CBD5E1;
}

QLabel#LoginStatus {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 8px 10px;
    color: #94A3B8;
    font-size: 12px;
}

QLabel#LoginStatus[state="info"] {
    color: #93C5FD;
}

QLabel#LoginStatus[state="busy"] {
    color: #93C5FD;
    border-color: #1D4ED8;
}

QLabel#LoginStatus[state="success"] {
    color: #6EE7B7;
    background-color: rgba(6, 95, 70, 0.18);
    border-color: rgba(16, 185, 129, 0.45);
}

QLabel#LoginStatus[state="error"] {
    color: #FCA5A5;
    background-color: rgba(127, 29, 29, 0.18);
    border-color: rgba(239, 68, 68, 0.45);
}

QLabel#SettingsAccountHint {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 9px 12px;
    color: #94A3B8;
    font-size: 12px;
}

QPushButton[role="secondary"]:disabled {
    color: #475569;
    border-color: #1E293B;
    background-color: #0F172A;
}

/* T27 自绘标题栏 */
QWidget#TitleBar {
    background-color: #0F172A;
    border-bottom: 1px solid #334155;
}

QLabel#TitleBarTitle {
    color: #CBD5E1;
    font-size: 12px;
    font-weight: 600;
}

QPushButton[titleBarButton="true"] {
    background-color: transparent;
    border: none;
    color: #94A3B8;
    font-size: 14px;
    padding: 0px;
}

QPushButton[titleBarButton="true"]:hover {
    background-color: #1E293B;
    color: #CBD5E1;
}

QPushButton[titleBarButton="true"]:pressed {
    background-color: #334155;
    color: #F8FAFC;
}

QPushButton#TitleBarCloseButton:hover {
    background-color: #DC2626;
    color: #FFFFFF;
}

QPushButton#TitleBarCloseButton:pressed {
    background-color: #B91C1C;
    color: #FFFFFF;
}

/* =========================================================================
   T43 qEmby 统一 token 覆盖（与 tokens.h 对应）
   颜色：bg #0F172A / surface #1E293B / border #334155 / hover #334155
   文字：#F8FAFC / #CBD5E1 / #94A3B8；accent #3B82F6 / hover #2563EB
   间距：4/8/12/16/24/32；圆角：6/8/10/12/16
   ========================================================================= */

QLineEdit#SearchBox {
    background-color: #1E293B;
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 500;
    color: #F8FAFC;
}
QLineEdit#SearchBox:hover { background-color: #334155; }
QLineEdit#SearchBox:focus { background-color: #0F172A; border: 1px solid #3B82F6; }

QPushButton[role="primary"] {
    background-color: #3B82F6;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 700;
}
QPushButton[role="primary"]:hover { background-color: #2563EB; }
QPushButton[role="primary"]:pressed { background-color: #1D4ED8; }

QPushButton[role="secondary"] {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 14px;
}
QPushButton[role="secondary"]:hover { background-color: #334155; border-color: #475569; }
QPushButton[role="secondary"]:pressed { background-color: #475569; }

QPushButton[role="ghost"] {
    color: #60A5FA;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton[role="ghost"]:hover { color: #93C5FD; background-color: rgba(96,165,250,0.10); }

QPushButton[navButton="true"] {
    color: #CBD5E1;
    font-size: 14px;
    font-weight: 500;
    padding: 0 12px;
    border-radius: 8px;
}
QPushButton[navButton="true"]:hover { background-color: #334155; color: #F8FAFC; }
QPushButton[navButton="true"]:checked { background-color: #1E3A8A; color: #60A5FA; font-weight: 700; }

QLabel#LibraryTitle, QLabel#PageTitle { font-size: 24px; font-weight: 700; color: #F8FAFC; }
QLabel#HomeSectionTitle { font-size: 20px; font-weight: 700; color: #F8FAFC; padding: 0 0 8px 0; }
QLabel#SectionTitle, QLabel#DetailSectionTitle { font-size: 20px; font-weight: 700; color: #F8FAFC; }
QLabel#DetailTitle { font-size: 28px; font-weight: 800; color: #F8FAFC; }
QLabel#DetailMeta, QLabel#DetailTagline { font-size: 14px; color: #94A3B8; }
QLabel#DetailOverview { font-size: 14px; color: #E2E8F0; }
QLabel#HomeSectionCardTitle, QLabel#ResumeCardTitle { font-size: 13px; font-weight: 600; color: #F8FAFC; }
QLabel#HomeSectionCardMeta, QLabel#ResumeCardMeta { font-size: 12px; color: #94A3B8; }
QLabel#SettingName { font-size: 14px; color: #CBD5E1; }
QLabel#SettingValue, QLabel#SettingsConnectionValue, QLabel#SettingsCacheUsageValue,
QLabel#SettingsHardwareDecoderValue, QLabel#SettingsAppVersionValue, QLabel#SettingsQtVersionValue,
QLabel#SettingsBuildTimeValue, QLabel#SettingsLibmpvVersionValue { font-size: 13px; color: #94A3B8; }
QLabel#SettingsGroup::title { font-size: 14px; color: #94A3B8; }

QGroupBox#SettingsGroup { border-radius: 12px; border: 1px solid #334155; }
QWidget#ResumeCard { border-radius: 10px; border: 1px solid #334155; }
QWidget#ResumeCard:hover { background-color: #334155; border-color: #3B82F6; }
QWidget#EpisodeRow { border-radius: 8px; border: 1px solid #334155; }
QWidget#EpisodeRow:hover { background-color: #334155; border-color: #475569; }
QWidget#SettingsLibraryRow { border-radius: 8px; border: 1px solid #334155; }
QWidget#SettingsLibraryRow:hover { border-color: #475569; }

QComboBox, QSpinBox, QLineEdit[role="formInput"] {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 14px;
    color: #F8FAFC;
    min-height: 20px;
}
QComboBox:hover, QSpinBox:hover, QLineEdit[role="formInput"]:hover { border-color: #475569; }
QComboBox:focus, QSpinBox:focus, QLineEdit[role="formInput"]:focus { border-color: #60A5FA; }

/* T43 焦点环：替代全局 outline:none；所有可聚焦控件可见 */
QPushButton:focus { border: 1px solid #60A5FA; }
QPushButton[role="primary"]:focus, QPushButton[role="secondary"]:focus,
QPushButton[role="ghost"]:focus, QPushButton[navButton="true"]:focus,
QPushButton[role="playerIcon"]:focus, QPushButton[role="playerPrimary"]:focus,
QPushButton[role="playerText"]:focus, QPushButton[titleBarButton="true"]:focus {
    border: 1px solid #60A5FA;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #60A5FA; }
QCheckBox:focus { color: #F8FAFC; }
QCheckBox::indicator:focus { border: 2px solid #60A5FA; }
QListView:focus, QAbstractItemView:focus { border: 2px solid #60A5FA; }
QScrollArea:focus { border: 1px solid #60A5FA; }

/* T44 首页 qEmby rails */
QWidget#HomeSectionCard {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}
QWidget#HomeSectionCard:hover {
    background-color: #1E293B;
    border-color: #334155;
    border-radius: 8px;
}
QPushButton#HomeSectionSeeAll {
    color: #60A5FA;
    background: transparent;
    border: none;
    padding: 4px 8px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#HomeSectionSeeAll:hover {
    color: #93C5FD;
    background-color: rgba(96, 165, 250, 0.10);
    border-radius: 6px;
}
QWidget#HomeSectionRow { background: transparent; }
QWidget#HomeSectionPreview { background: transparent; }


/* T45 设置页：左侧分类导航 + 右侧分组 */
QWidget#SettingsPage { background-color: #0F172A; }
QWidget#SettingsSidebar {
    background-color: #0F172A;
    border-right: 1px solid #334155;
}
QLabel#SettingsNavTitle {
    font-size: 24px;
    font-weight: 700;
    color: #F8FAFC;
    padding-left: 4px;
}
QPushButton#SettingsNavButton {
    text-align: left;
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 14px;
    font-weight: 500;
    color: #94A3B8;
}
QPushButton#SettingsNavButton:hover {
    background-color: #334155;
    color: #F8FAFC;
}
QPushButton#SettingsNavButton:checked {
    background-color: #1E3A8A;
    color: #60A5FA;
    font-weight: 700;
}
QPushButton#SettingsNavButton:focus { border: 2px solid #60A5FA; }
QLabel#SettingsNavHint {
    font-size: 11px;
    color: #64748B;
    padding: 8px 4px 0 4px;
}
QScrollArea#SettingsScroll {
    background: transparent;
    border: none;
}


/* T45 设置页分组行距与对比度 */
QGroupBox#SettingsGroup {
    border-radius: 12px;
    margin-top: 18px;
    padding: 16px 16px 14px 16px;
}
QGroupBox#SettingsGroup::title {
    font-size: 14px;
    font-weight: 600;
    color: #94A3B8;
    left: 16px;
    padding: 0 8px;
}
QLabel#SettingName {
    font-size: 14px;
    color: #CBD5E1;
}
QLabel#SettingValue,
QLabel#SettingsConnectionValue,
QLabel#SettingsCacheUsageValue,
QLabel#SettingsHardwareDecoderValue,
QLabel#SettingsAppVersionValue,
QLabel#SettingsQtVersionValue,
QLabel#SettingsBuildTimeValue,
QLabel#SettingsLibmpvVersionValue {
    font-size: 13px;
    color: #94A3B8;
}
QWidget#SettingsLibraryRow { padding: 8px 12px; }


/* T64 首页错误/加载横幅与卡片焦点 */
QWidget#HomeSectionsBanner {
    background-color: #1E293B;
    border-bottom: 1px solid #334155;
}
QLabel#HomeSectionsBannerLabel {
    color: #E2E8F0;
    font-size: 13px;
}
QLabel#HomeSectionsBannerLabel[state="error"] {
    color: #FCA5A5;
}
QWidget#ResumeCard:focus, QWidget#HomeSectionCard:focus {
    border: 1px solid #60A5FA;
}
